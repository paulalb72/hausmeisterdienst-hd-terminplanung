# Konfiguration fuer "docker compose up -d".
# Kopieren nach .env und ausfuellen. Die Datei gehoert NICHT ins Git.

# --- Datenbank -------------------------------------------------------------
# Langes Zufallspasswort, z. B. mit: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Anwendung -------------------------------------------------------------
# Port auf dem Host, auf den der Reverse Proxy zeigt (nur auf 127.0.0.1).
APP_PORT=4000

# --- Web-Push --------------------------------------------------------------
# Einmalig erzeugen mit:
#   docker compose run --rm --no-deps app npm run genkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@hausmeister-service-frankfurt.de

# --- Erster Zugang ---------------------------------------------------------
SEED_CHEF_NAME=Chef
# Leer lassen: Der Server erzeugt beim ersten Start eine Zufalls-PIN und
# schreibt sie ins Log (docker compose logs app).
SEED_CHEF_PIN=
