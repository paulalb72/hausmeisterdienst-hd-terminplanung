# --- Datenbank -------------------------------------------------------------
DATABASE_URL=postgres://hd_user:PASSWORT@localhost:5432/hd_dispo
# Auf "true" setzen, wenn Postgres auf einem anderen Host liegt und TLS nutzt.
PGSSL=false

# --- Server ----------------------------------------------------------------
PORT=4000
NODE_ENV=production
# "true", sobald nginx/Caddy davor steht. Ohne das greifen die Rate-Limits
# fuer alle Nutzer gemeinsam, weil nur die Proxy-IP ankommt.
TRUST_PROXY=true

# --- Web-Push (npm run genkeys erzeugt die beiden Schluessel) --------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@hausmeister-service-frankfurt.de

# --- Erster Zugang ---------------------------------------------------------
SEED_CHEF_NAME=Chef
# Leer lassen: Der Server erzeugt beim allerersten Start eine Zufalls-PIN und
# schreibt sie ins Log. Nur setzen, wenn die PIN bewusst vorgegeben werden soll.
SEED_CHEF_PIN=
